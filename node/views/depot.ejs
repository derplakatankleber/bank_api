<%- include("partials/header", { title: "Depot - Bank Control Center" }) %>
<% if (refreshed) { %>
  <div class="alert alert-success">Balances refreshed.</div>
<% } %>
<% if (error) { %>
  <div class="alert alert-error"><%= error %></div>
<% } %>
<section class="card">
  <div class="card-header">
    <h2>Depot overview</h2>
    <form method="post" action="/balances/refresh" class="inline-form">
      <input type="hidden" name="redirect_to" value="/depot">
      <button type="submit">Refresh</button>
    </form>
  </div>
  <% if (balances.length) { %>
  <table class="data-table">
    <thead><tr><th>Account</th><th>Amount</th><th>Currency</th></tr></thead>
    <tbody>
      <% for (const balance of balances) { %>
      <tr><td><%= balance.account_id || "n/a" %></td><td><%= balance.amount ?? "n/a" %></td><td><%= balance.currency || "n/a" %></td></tr>
      <% } %>
    </tbody>
  </table>
  <div class="totals">
    <h3>Totals</h3>
    <ul>
      <% for (const [currency, amount] of Object.entries(totals)) { %>
      <li><%= currency %> <%= amount.toFixed(2) %></li>
      <% } %>
    </ul>
  </div>
  <% } else { %>
  <p>No balances available. Use Refresh to fetch current balances.</p>
  <% } %>
</section>
<%- include("partials/footer") %>
