<%- include("partials/header", { title: "Create Order - Bank Control Center" }) %>
<section class="card">
  <h2>Create order</h2>
  <form method="post" action="/orders" class="form-grid">
    <label>
      Instrument
      <span class="field-help">Name, symbol, ISIN or other identifier for the security you want to track locally.</span>
      <input type="text" name="instrument" required>
    </label>
    <label>
      Side
      <span class="field-help">Choose whether the local order represents a buy or sell action.</span>
      <select name="side" required><option value="buy">Buy</option><option value="sell">Sell</option></select>
    </label>
    <label>
      Order type
      <span class="field-help">Market orders have no limit price; limit orders use the optional limit price field.</span>
      <select name="order_type" required><option value="market">Market</option><option value="limit">Limit</option></select>
    </label>
    <label>
      Quantity
      <span class="field-help">Number of units for the locally tracked order.</span>
      <input type="number" name="quantity" min="0" step="0.01" required>
    </label>
    <label>
      Limit price
      <span class="field-help">Optional price limit for limit orders. Leave empty for market-style tracking.</span>
      <input type="number" name="limit_price" min="0" step="0.01">
    </label>
    <label>
      Notes
      <span class="field-help">Optional internal note; it is stored locally and not sent to comdirect.</span>
      <textarea name="notes" rows="3"></textarea>
    </label>
    <button type="submit">Submit order</button>
  </form>
</section>
<%- include("partials/footer") %>
