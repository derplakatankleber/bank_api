<%- include("partials/header", { title: "Orders - Bank Control Center" }) %>
<section class="card">
  <header class="card-header">
    <h2>Orders</h2>
    <a class="button" href="/orders/new">Create order</a>
  </header>
  <% if (orders.length) { %>
  <table class="data-table">
    <thead>
      <tr><th>ID</th><th>Instrument</th><th>Side</th><th>Type</th><th>Quantity</th><th>Limit</th><th>Status</th><th>Created</th><th>Actions</th></tr>
    </thead>
    <tbody>
      <% for (const order of orders) { %>
      <tr>
        <td><%= order.id %></td>
        <td><%= order.instrument %></td>
        <td><%= capitalize(order.side) %></td>
        <td><%= capitalize(order.order_type) %></td>
        <td><%= order.quantity %></td>
        <td><%= order.limit_price || "Market" %></td>
        <td><span class="status status-<%= order.status %>"><%= capitalize(order.status) %></span></td>
        <td><%= order.created_at %></td>
        <td>
          <form method="post" action="/orders/<%= order.id %>/status" class="inline-form">
            <select name="status">
              <% for (const option of ["pending", "placed", "executed", "cancelled"]) { %>
              <option value="<%= option %>" <%= order.status === option ? "selected" : "" %>><%= capitalize(option) %></option>
              <% } %>
            </select>
            <button type="submit">Update</button>
          </form>
        </td>
      </tr>
      <% } %>
    </tbody>
  </table>
  <% } else { %>
  <p>No orders recorded yet. <a href="/orders/new">Create one now</a>.</p>
  <% } %>
</section>
<%- include("partials/footer") %>
